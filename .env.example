# Copy to .env, generate independent secrets locally, and chmod 600 .env.
# Empty required secrets intentionally prevent startup.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=lab_web
POSTGRES_USER=lab_web
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Enable only when the public entry point uses HTTPS; localhost HTTP uses False.
DJANGO_COOKIE_SECURE=False
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_IP_LIMIT=10
AUTH_LOGIN_IP_LIMIT=60
