# Copy to .env, generate independent secrets locally, and chmod 600 .env.
# Empty required secrets intentionally prevent startup.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POSTGRES_DB=lab_web
POSTGRES_USER=lab_web
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Enable only when the public entry point uses HTTPS; localhost HTTP uses False.
DJANGO_COOKIE_SECURE=False
AUTH_LOGIN_WINDOW_SECONDS=900
AUTH_LOGIN_ACCOUNT_IP_LIMIT=10
AUTH_LOGIN_IP_LIMIT=60

# V7 opt-in AI. Fill reviewed prices/date before enabling; never expose this key to a browser.
AI_ENABLED=False
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
AI_CONNECT_TIMEOUT_SECONDS=5
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2
AI_MAX_INPUT_TOKENS=24000
AI_MAX_OUTPUT_TOKENS=4000
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=100
AI_GLOBAL_DAILY_BUDGET_CNY=10
AI_PRICE_INPUT_CNY_PER_MILLION=
AI_PRICE_OUTPUT_CNY_PER_MILLION=
AI_PRICE_EFFECTIVE_DATE=
AI_SOURCE_RETENTION_DAYS=7
AI_CANDIDATE_RETENTION_DAYS=30
AI_LEASE_SECONDS=240

# V9: enable only after real HTTPS/proxy verification.
TRUSTED_PROXY_NETWORKS=
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SSL_REDIRECT=False
DJANGO_HSTS_SECONDS=0

# V9 optional dedicated runtime role; provision with server-only command before setting.
POSTGRES_RUNTIME_USER=
POSTGRES_RUNTIME_PASSWORD=

# Fail-closed local virus scanner: provide/mount a protected clamd UNIX socket first.
FILE_SCAN_REQUIRED=False
CLAMAV_SOCKET=

# V18: generate an independent Fernet key privately; never commit real values.
ACCOUNT_IMPORT_KEY=
# Root-created account default; configure privately on deployment host.
INITIAL_ACCOUNT_PASSWORD=
